@{
    ViewData["Title"] = "Travel";
}

<div class="text-center">

    <div class="row">
        <div class="col">
            <h2>Public Transportation</h2>
            <p>The venue is accessible via many MBTA subway and bus lines, the MBTA commuter rail, and Amtrak lines. It is located equidistant between North Station and Haymarket. Please feel free to reach out and we can help you plan your travel.</p>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Parking</h2>
            <p>
                There are a few parking garages located in the area in addition to street parking.
                The North Station Garage is located at 140 Causeway St. Availability will depend on any events occurring at TD Garden.
                The Haymarket Center Garage is located at 136 Blackstone Street.
                The Government Center Garage is located at 50 Sudbury St. Parking can be 
                @Html.Hyperlink("purchased in advance online", "https://www.governmentcentergarage.com/") as well as at the garage.
            </p>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <h2>Marriott Boston Downtown/North Station</h2>
            <p>
                We have a group rate at the Marriott Courtyard Downtown/North Station.  You might be able to get a better rate by pre-paying.
                The group rate is $299 - $339 depending on the room.
                <br />
                <a href="https://www.marriott.com/event-reservations/reservation-link.mi?id=1781724211380&key=GRP&app=resvlink" rel="nofollow">Book the group rate</a>
            </p>
        </div>
    </div>

</div>