@{
    ViewData["Title"] = "Home Page";
}

<div class="banner">
    <div class="banner-date-location d-flex justify-content-center">
        <div id="banner-date">
            August<br />22, 2026
        </div>
        <div id="banner-location">
            Boston<br />MA
        </div>
    </div>
</div>

<div id="wedding-agenda" class="text-center">

    <div class="row">
        <div class="col">
            <div class="fw-bold">Wedding Day</div>
            <div>August 22, 2026</div>
            <div class="pt-2">
                City Winery Boston<br />
                80 Beverly Street, Boston, MA 02114
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-6">
            <ul class="agenda">
                <li>
                    <span class="time">5:00pm - 6:00pm</span>
                    <span class="activity">Cocktail Hour</span>
                </li>
                <li>
                    <span class="time">6:00pm - 6:30pm</span>
                    <span class="activity">Ceremony</span>
                </li>
                <li>
                    <span class="time">6:30pm - 7:30pm</span>
                    <span class="activity">Dinner</span>
                </li>
                <li>
                    <span class="time">7:30pm - 10:00pm</span>
                    <span class="activity">Reception</span>
                </li>
            </ul>
        </div>
    </div>

</div>