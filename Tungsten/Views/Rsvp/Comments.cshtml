@model Tuple<Guest, List<Guest>?>
@{
    Guest guest = Model.Item1;
    List<Guest> family = Model.Item2 ?? new List<Guest>();
    int i = 1;
}

<div class="rsvp" style="max-width: 500px; margin: 0 auto;">
    <form method="post" action="/rsvp/comments">
        <h3>Leave us a note!</h3>
        <p>We're sorry we'll miss you!</p>
        
        <div class="mb-4">
            <textarea class="form-control"
                      id="notes"
                      rows="3"
                      name="note"
                      placeholder="Leave us a note!">@guest.Comments</textarea>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-rsvp btn-lg px-5">
                Submit
            </button>
        </div>
    </form>
</div>
